# Application Settings
APP_NAME=MicroBrain
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite+aiosqlite:///./microbrain.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@localhost/microbrain

# Redis
REDIS_URL=redis://localhost:6379/0

# HuggingFace
HUGGINGFACE_API_KEY=your-huggingface-api-key
HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct
HF_API_URL=https://api-inference.huggingface.co/models

# OpenAI (Optional)
OPENAI_API_KEY=your-openai-api-key

# Cohere (Optional)
COHERE_API_KEY=your-cohere-api-key

# Vector Storage
VECTOR_STORE_TYPE=chroma  # Options: chroma, qdrant, faiss
CHROMA_PERSIST_DIR=./Data/chroma
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=pdf,docx,pptx,txt,md,html

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
